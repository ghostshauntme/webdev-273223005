# Example names and non-secret defaults only. Inject actual values into the process.
NODE_ENV=development
PORT=3000
DB_PATH=data/club-events.db
# Required in production. Use the Neon PostgreSQL URL with TLS enabled.
DATABASE_URL=
# One-time npm run setup only. At least eight characters.
SEED_PASSWORD=
# Optional Google OAuth. Set all three together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Optional Gemini provider. Empty enables manual entry.
GEMINI_API_KEY=
# Optional local MCP client only. Supply an existing session token securely.
MCP_SESSION_TOKEN=
